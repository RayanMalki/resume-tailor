# ── Required ─────────────────────────────────────────────────────────
DATABASE_URL=postgres://app:app_password@localhost:5433/resume_tailor?sslmode=disable
OPENAI_API_KEY=

# ── Server ───────────────────────────────────────────────────────────
HTTP_ADDR=":8080"
WORKER_ID="worker-1"
API_BASE_URL="http://localhost:8080"
FRONTEND_ORIGIN="http://localhost:3000"

# ── AI model ─────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini

# ── PDF generation ───────────────────────────────────────────────────
RESUME_PDF_ENABLED="0"
TECTONIC_BIN="tectonic"

# ── Email verification (optional — runs in log mode if not set) ──────
# Supported providers: "resend", "sendgrid", or leave empty for log mode.
# Sign up at https://resend.com (free tier: 3,000 emails/month)
# or https://sendgrid.com (free tier: 100 emails/day).
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM="Resume Tailor <noreply@resumetailor.app>"

# ── Monitoring (optional — logs only if not set) ─────────────────────
# Sign up at https://sentry.io (free tier: 5K errors/month).
# Create a Go project and copy the DSN here.
SENTRY_DSN=""

# ── Google OAuth (optional) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URL=""

# ── Discord notifications (optional) ─────────────────────────────────
DISCORD_WEBHOOK_URL=""

# ── Database migrations ──────────────────────────────────────────────
RUN_MIGRATIONS="1"
